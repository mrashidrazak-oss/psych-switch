_$HalfLifeImpl _$$HalfLifeImplFromJson(Map<String, dynamic> json) =>
    _$HalfLifeImpl(
      meanHours: (json['meanHours'] as num).toDouble(),
      rangeHours:
          (json['rangeHours'] as List<dynamic>)
              .map((e) => (e as num).toDouble())
              .toList(),
      notes: json['notes'] as String?,
    );

Map<String, dynamic> _$$HalfLifeImplToJson(_$HalfLifeImpl instance) =>
    <String, dynamic>{
      'meanHours': instance.meanHours,
      'rangeHours': instance.rangeHours,
      'notes': instance.notes,
    };

