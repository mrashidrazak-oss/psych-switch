# Environment variables for PsychSwitch.
#
# Copy to `.env` (gitignored) and fill in values for local development.
# For EAS production builds, set the same keys in the EAS dashboard or
# via `eas secret:create` so they ship as build-time env vars.
#
#   https://docs.expo.dev/build-reference/variables/
#
# Anything prefixed `EXPO_PUBLIC_` is bundled into the JS at build time
# and IS visible to clients. Never put real secrets behind that prefix.

# ── Sentry (crash reporting) ─────────────────────────────────────────
# Currently a no-op stub (utils/sentry.ts). Re-introduce the real
# reporter when we move from Expo Go to a custom development build —
# at that point set this DSN via `eas secret:create --name SENTRY_DSN`.
SENTRY_DSN=

# ── Build environment marker ─────────────────────────────────────────
# Set automatically by eas.json profiles (development / preview /
# simulator / production). Override locally only if you want to test
# production-build-only behaviour from a dev session.
EXPO_PUBLIC_BUILD_ENV=development
