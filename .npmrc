# Force pnpm to install dependencies in a flat, npm-style layout instead
# of its default nested ".pnpm/" symlink layout. Required because
# React Native's Metro bundler does not reliably traverse pnpm's nested
# structure to resolve packages — every native-deps upgrade can re-break
# resolution otherwise.
#
# Trade-off: loses some of pnpm's strict-deps benefits (you can
# accidentally import an undeclared transitive dep). Acceptable for a
# small solo-maintained app.
node-linker=hoisted

# @sentry/cli runs a postinstall to download the native CLI binary used
# for symbolicated stack traces. Ignore (don't run) the script — we use
# Sentry as a runtime SDK, not for source-map upload locally; the EAS
# build hooks will run the CLI when needed.
ignored-built-dependencies[]=@sentry/cli
