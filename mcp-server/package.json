{
  "name": "@psychswitch/mcp",
  "version": "0.4.2",
  "description": "Model Context Protocol server exposing the PsychSwitch clinical engine as queryable tools.",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "bin": {
    "psychswitch-mcp": "./bin/psychswitch-mcp.mjs"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/smoke.ts"
  },
  "keywords": [
    "psychswitch",
    "mcp",
    "model-context-protocol",
    "clinical-decision-support",
    "psychiatry"
  ],
  "author": "Rashid Razak",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
