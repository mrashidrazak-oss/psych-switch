{
  "name": "psych-switch",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm test && pnpm --dir mcp-server test",
    "preflight": "pnpm verify",
    "build:dev": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform android",
    "build:simulator": "eas build --profile simulator --platform ios",
    "build:production": "pnpm preflight && eas build --profile production --platform android",
    "build:ios:dev": "eas build --profile development --platform ios",
    "build:ios:preview": "eas build --profile preview --platform ios",
    "build:ios:production": "pnpm preflight && eas build --profile production --platform ios",
    "submit:ios": "eas submit --platform ios --latest",
    "submit:android": "eas submit --platform android --latest",
    "update:preview": "eas update --branch preview --message",
    "update:production": "eas update --branch production --message"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.12",
    "expo": "~54.0.34",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "^55.0.16",
    "expo-device": "~8.0.10",
    "expo-haptics": "~15.0.8",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.17",
    "nativewind": "~4.1.10",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css-interop": "0.1.22",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.1.17",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
